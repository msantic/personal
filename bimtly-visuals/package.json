{
  "name": "bimtly-promo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:pdf": "node scripts/generate-pdf.js",
    "build:flyer": "node scripts/generate-pdf.js flyer",
    "build:deck": "node scripts/generate-pdf.js deck",
    "build:png": "node scripts/generate-png.js all",
    "build:connectivity": "node scripts/generate-png.js connectivity",
    "build:platform-png": "node scripts/generate-png.js platform",
    "capture:thumbnails": "node scripts/capture-demo-thumbnails.js all",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:render": "remotion render src/remotion/index.ts HeroVideo output/hero/hero-video.mp4",
    "render:web": "remotion render src/remotion/index.ts HeroVideo output/hero/hero-web-1920x1080.mp4",
    "render:youtube": "remotion render src/remotion/index.ts HeroVideo-YouTube output/hero/hero-youtube-1920x1080.mp4",
    "render:instagram": "remotion render src/remotion/index.ts HeroVideo-Instagram output/hero/hero-instagram-1080x1080.mp4",
    "render:reels": "remotion render src/remotion/index.ts HeroVideo-Reels output/hero/hero-reels-1080x1920.mp4",
    "render:tiktok": "remotion render src/remotion/index.ts HeroVideo-TikTok output/hero/hero-tiktok-1080x1920.mp4",
    "render:linkedin": "remotion render src/remotion/index.ts HeroVideo-LinkedIn output/hero/hero-linkedin-1920x1080.mp4",
    "render:portrait": "remotion render src/remotion/index.ts HeroVideo-Portrait output/hero/hero-portrait-1080x1350.mp4",
    "render:all": "npm run render:web && npm run render:instagram && npm run render:reels && npm run render:linkedin",
    "render:intro": "remotion render src/remotion/index.ts IntroClip output/clips/intro-1920x1080.mp4",
    "render:intro:4k": "remotion render src/remotion/index.ts IntroClip-4K output/clips/intro-3840x2160.mp4",
    "render:outro": "remotion render src/remotion/index.ts OutroClip output/clips/outro-1920x1080.mp4",
    "render:outro:4k": "remotion render src/remotion/index.ts OutroClip-4K output/clips/outro-3840x2160.mp4",
    "render:clips": "npm run render:intro && npm run render:outro",
    "render:clips:4k": "npm run render:intro:4k && npm run render:outro:4k",
    "merge:intro": "node scripts/merge-intro.js",
    "merge:intro:4k": "node scripts/merge-intro.js --4k",
    "render:promo": "remotion render src/remotion/index.ts PromoMaterialCatalog output/material-catalog/promo-material-catalog-1920x1080.mp4",
    "render:promo:square": "remotion render src/remotion/index.ts PromoMaterialCatalog-Square output/material-catalog/promo-material-catalog-1080x1080.mp4",
    "render:promo:vertical": "remotion render src/remotion/index.ts PromoMaterialCatalog-Vertical output/material-catalog/promo-material-catalog-1080x1920.mp4",
    "render:promo:portrait": "remotion render src/remotion/index.ts PromoMaterialCatalog-Portrait output/material-catalog/promo-material-catalog-1080x1350.mp4",
    "render:promo:all": "npm run render:promo && npm run render:promo:square && npm run render:promo:vertical && npm run render:promo:portrait",
    "render:cnc-demo": "remotion render src/remotion/index.ts PromoCncDemo output/cnc-demo/cnc-demo-3840x2160.mp4",
    "render:scrolling-grid": "remotion render src/remotion/index.ts ScrollingGrid output/hero/scrolling-grid-1920x1080.mp4 && npm run webm:scrolling-grid",
    "webm:scrolling-grid": "ffmpeg -y -i output/hero/scrolling-grid-1920x1080.mp4 -c:v libvpx-vp9 -b:v 1.6M -crf 32 -pix_fmt yuv420p -an -deadline good -cpu-used 2 -row-mt 1 -tile-columns 2 -threads 8 -colorspace bt709 -color_primaries bt709 -color_trc bt709 -color_range tv -vf scale=in_color_matrix=bt709:out_color_matrix=bt709 -map_metadata -1 output/hero/scrolling-grid-1920x1080.webm"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.417",
    "@remotion/player": "^4.0.417",
    "i18next": "^23.16.0",
    "lucide-react": "^0.563.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.28.0",
    "remotion": "^4.0.417"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "puppeteer": "^23.6.0",
    "puppeteer-screen-recorder": "^3.0.6",
    "sharp": "^0.34.5",
    "vite": "^5.4.10"
  }
}
